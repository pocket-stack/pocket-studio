{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "channel": {
      "type": "string",
      "const": "stable"
    },
    "publication_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "parent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "publication_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": ["publication_id", "sha256"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "listing": {
            "default": "listed",
            "type": "string",
            "enum": ["listed", "unlisted"]
          },
          "publisher": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": ["id", "name", "verified"],
            "additionalProperties": false
          },
          "category": {
            "type": "string",
            "enum": ["runtime", "tool", "app", "game"]
          },
          "source": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "format": "uri"
              },
              "path": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "required": ["repository", "path"],
            "additionalProperties": false
          },
          "locales": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "summary": {
                  "type": "string",
                  "maxLength": 4096
                },
                "description": {
                  "type": "string",
                  "maxLength": 100000
                }
              },
              "required": ["name", "summary", "description"],
              "additionalProperties": false
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": ["icon", "screenshot"]
                },
                "blob": {
                  "type": "object",
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "content_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": ["sha256", "size_bytes", "content_type"],
                  "additionalProperties": false
                },
                "locale": {
                  "type": ["string", "null"]
                },
                "target_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sort_order": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["role", "blob", "locale", "target_id", "sort_order"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "slug",
          "listing",
          "publisher",
          "category",
          "source",
          "locales",
          "media"
        ],
        "additionalProperties": false
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "app_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "notes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 100000
            }
          },
          "published_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": ["published", "yanked"]
          },
          "artifacts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "format": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                },
                "blob": {
                  "type": "object",
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "content_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": ["sha256", "size_bytes", "content_type"],
                  "additionalProperties": false
                },
                "build_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "native_identity": {
                  "anyOf": [
                    {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "ios_bundle"
                            },
                            "bundle_id": {
                              "type": "string",
                              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                            },
                            "version": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096
                            },
                            "build_number": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096
                            }
                          },
                          "required": [
                            "kind",
                            "bundle_id",
                            "version",
                            "build_number"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "3ds_title"
                            },
                            "title_id": {
                              "type": "string",
                              "pattern": "^00040000[0-9a-f]{8}$"
                            },
                            "title_version": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 65535
                            }
                          },
                          "required": ["kind", "title_id", "title_version"],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "homebrew_file"
                            },
                            "entrypoint": {
                              "type": "string",
                              "pattern": "^3ds\\/[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}\\/boot\\.3dsx$"
                            }
                          },
                          "required": ["kind", "entrypoint"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "provenance": {
                  "type": "object",
                  "properties": {
                    "source_commit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "runtime_commit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "manifest_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "source_commit",
                    "runtime_commit",
                    "manifest_sha256"
                  ],
                  "additionalProperties": false
                },
                "targets": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "target_id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                      },
                      "platform": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                      },
                      "arch": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                      },
                      "models": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9,._-]{0,199}$"
                        }
                      },
                      "os": {
                        "type": "object",
                        "properties": {
                          "min": {
                            "type": "string",
                            "pattern": "^\\d+(?:\\.\\d+){0,2}$"
                          },
                          "max": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^\\d+(?:\\.\\d+){0,2}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "builds": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4096
                            }
                          }
                        },
                        "required": ["min", "max", "builds"],
                        "additionalProperties": false
                      },
                      "host_abi": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "runtime_deliveries": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": ["bundled", "shared"]
                        }
                      },
                      "installer_id": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                      },
                      "requires": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "ios"
                              },
                              "jailbreak": {
                                "type": "boolean"
                              },
                              "appsync": {
                                "type": "boolean"
                              }
                            },
                            "required": ["kind", "jailbreak", "appsync"],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "3ds"
                              },
                              "cfw": {
                                "type": "boolean"
                              }
                            },
                            "required": ["kind", "cfw"],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "runtime_requirement": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                              },
                              "min_version": {
                                "type": "string",
                                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                              },
                              "bootstrap_app_id": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "id",
                              "min_version",
                              "bootstrap_app_id"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "runtime_provides": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"
                              },
                              "version": {
                                "type": "string",
                                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                              },
                              "capabilities": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "guest-update",
                                    "app-library",
                                    "cia-management",
                                    "file-management"
                                  ]
                                }
                              }
                            },
                            "required": ["id", "version", "capabilities"],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "target_id",
                      "platform",
                      "arch",
                      "models",
                      "os",
                      "host_abi",
                      "runtime_deliveries",
                      "installer_id",
                      "requires",
                      "runtime_requirement",
                      "runtime_provides"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "format",
                "blob",
                "build_id",
                "native_identity",
                "provenance",
                "targets"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "app_id",
          "version",
          "revision",
          "notes",
          "published_at",
          "status",
          "artifacts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "repository_id",
    "channel",
    "publication_id",
    "sequence",
    "parent",
    "created_at",
    "expires_at",
    "apps",
    "releases"
  ],
  "additionalProperties": false
}
