{
  "name": "pocket-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "scripts": {
    "sync:store-protocol": "node scripts/sync-store-protocol.mjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:frontend": "pnpm lint && pnpm typecheck && pnpm format:check",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "check": "pnpm check:frontend && pnpm check:native",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "tauri": "tauri",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:ui": "node scripts/check-viewport.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "motion-v": "2.4.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/svg-spinners": "1.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "json-schema-to-typescript": "^16.0.0",
    "lefthook": "^2.1.12",
    "playwright-core": "1.57.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
